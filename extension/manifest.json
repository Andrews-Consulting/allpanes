{
  "manifest_version": 3,
  "name": "allPanes",
  "version": "1.0.1",
  "description": "Capture the whole page as one image, including every pane that scrolls on its own.",
  "homepage_url": "https://github.com/Andrews-Consulting/full-page-screen-capture",
  "permissions": ["debugger", "storage"],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Capture full page (all panes)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture full page (all panes)"
    }
  }
}
